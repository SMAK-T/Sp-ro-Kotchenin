# Ne pas committer les fichiers .env / .env.local.
# Activer après création du projet Sanity et import des contenus.
CMS_PROVIDER=local
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Jetons privés du serveur : jamais de préfixe SANITY_STUDIO_ pour un jeton.
SANITY_READ_TOKEN=
SANITY_WRITE_TOKEN=
# En développement : http://localhost:3333 ; après build local : /studio/
SANITY_STUDIO_URL=/studio/
